{
  "name": "editor-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "npm run build -w @usememos/editor",
    "size": "npm run build && node packages/editor/scripts/size.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:themed": "playwright test --project=themed",
    "test:perf": "playwright test --project=perf --workers=1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "esbuild": "0.25.12",
    "happy-dom": "20.14.5",
    "katex": "0.16.45",
    "lucide": "1.55.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  }
}
