{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": [],
    "jsx": "react-jsx",
    "paths": {
      "@usememos/editor": [
        "./packages/editor/src/index.ts"
      ],
      "@usememos/editor/react": [
        "./packages/editor/src/react/index.tsx"
      ],
      "#entities": [
        "./packages/editor/src/markdown/entities.ts"
      ]
    }
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "playground"
  ],
  "exclude": [
    "playground/vite.config.ts",
    "vitest.config.ts"
  ]
}